# Copy to .env and fill in. Never commit .env.

# --- AI providers (set the ones you have) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# "free" keeps private memories away from Gemini (Google may use free-tier prompts to improve its products).
GEMINI_TIER=free
OPENROUTER_API_KEY=
# Optional: Ollama on your PC over Tailscale, e.g. http://my-pc.your-tailnet.ts.net:11434/v1
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:8b

# --- Owner ---
FEROXES_OWNER_NAME=
FEROXES_TIMEZONE=UTC
# observer | assistant | delegate | autopilot
FEROXES_PRESET=assistant

# --- Budgets (USD) ---
FEROXES_MONTHLY_BUDGET_USD=30
FEROXES_DAILY_BUDGET_USD=2
FEROXES_BACKGROUND_DAILY_USD=0.25

# --- Storage ---
FEROXES_WORKSPACE_DIR=./workspace
FEROXES_DATA_DIR=./data
# 32 random bytes, base64. Generate with: node apps/core/src/cli.ts keygen
FEROXES_MASTER_KEY=

# --- Kiro as the main brain (owner's explicit choice; see docs/07-kiro-brain.md) ---
# On by default when a key is set below (or FEROXES_KIRO_USE_LOGIN=true with `kiro-cli login`).
FEROXES_KIRO_BRAIN=true
# reasoning = Kiro for chat/planning/decisions/reflection; all = also fast-tier utility (slower, more credits)
FEROXES_KIRO_SCOPE=reasoning
# Use an existing `kiro-cli login` session instead of a key:
FEROXES_KIRO_USE_LOGIN=false
KIRO_API_KEY=
KIRO_CLI_COMMAND=kiro-cli
# Optional Kiro custom agent with tools disabled, so Kiro only reasons:
KIRO_CLI_AGENT=
# Pin specific Kiro models, or leave blank to let Kiro choose:
KIRO_FRONTIER_MODEL=
KIRO_BALANCED_MODEL=
